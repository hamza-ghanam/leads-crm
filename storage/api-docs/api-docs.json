{
    "openapi": "3.0.0",
    "info": {
        "title": "Leads CRM API",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Main API Server"
        }
    ],
    "paths": {
        "/api/v1/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login user",
                "description": "Authenticate user using email and password",
                "operationId": "bae68d1c55329ecb6e41f48285840c8f",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/CorrelationId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "crm-sadmin@gocodi.ae"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string"
                                                },
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "email": {
                                                            "type": "string"
                                                        },
                                                        "phone": {
                                                            "type": "string"
                                                        },
                                                        "status": {
                                                            "type": "string"
                                                        },
                                                        "role": {
                                                            "type": "string"
                                                        },
                                                        "created_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Account banned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many login attempts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/leads": {
            "get": {
                "tags": [
                    "Leads"
                ],
                "summary": "List leads",
                "description": "Returns a paginated list of leads based on the user's role with filtering support.",
                "operationId": "d660caaedd473f1082c49dca5634bb53",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter by lead status (same values as web)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Follow-up"
                        }
                    },
                    {
                        "name": "assigned_to",
                        "in": "query",
                        "description": "Filter by assigned sales user ID",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 12
                        }
                    },
                    {
                        "name": "date_from",
                        "in": "query",
                        "description": "Filter leads created from this date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-01-01"
                        }
                    },
                    {
                        "name": "date_to",
                        "in": "query",
                        "description": "Filter leads created until this date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-01-31"
                        }
                    },
                    {
                        "name": "lead_id",
                        "in": "query",
                        "description": "Filter by exact lead ID",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 123
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page (max 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1,
                            "example": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Lead"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginationMeta"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Leads"
                ],
                "summary": "Create a new lead",
                "description": "Creates a new lead (admin/super-admin only). assigned_to is required.",
                "operationId": "createLead",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Idempotency key to prevent duplicate execution",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "3f2c8c8e-1a34-4a0e-9c7b-0f2d2e7c4b91"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "full_name",
                                    "phone_number",
                                    "source_id",
                                    "assigned_to"
                                ],
                                "properties": {
                                    "campaign_name": {
                                        "type": "string",
                                        "example": "Meta - Jan Campaign",
                                        "nullable": true
                                    },
                                    "full_name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com",
                                        "nullable": true
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "+971501234567"
                                    },
                                    "source_id": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "assigned_to": {
                                        "type": "integer",
                                        "example": 25
                                    },
                                    "preferred_time": {
                                        "type": "string",
                                        "example": "18:00",
                                        "nullable": true
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Call after 6pm",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Lead created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "lead": {
                                                    "$ref": "#/components/schemas/Lead"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/leads/{id}": {
            "get": {
                "tags": [
                    "Leads"
                ],
                "summary": "Get lead details",
                "description": "Returns lead details with last follow-up and permissions",
                "operationId": "getLeadDetails",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Lead ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 123
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lead details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "lead": {
                                                    "$ref": "#/components/schemas/Lead"
                                                },
                                                "last_follow_up": {
                                                    "$ref": "#/components/schemas/LastFollowUp"
                                                },
                                                "permissions": {
                                                    "$ref": "#/components/schemas/LeadPermissions"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Lead not found or not visible",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/leads/{id}/move-forward": {
            "post": {
                "tags": [
                    "Leads"
                ],
                "summary": "Move lead forward (change status)",
                "operationId": "moveLeadForward",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Lead ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 123
                        }
                    },
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Idempotency key to prevent duplicate execution",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "3f2c8c8e-1a34-4a0e-9c7b-0f2d2e7c4b91"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "status_id",
                                    "comment"
                                ],
                                "properties": {
                                    "status_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "assigned_to": {
                                        "type": "integer",
                                        "example": 13,
                                        "nullable": true
                                    },
                                    "comment": {
                                        "type": "string",
                                        "example": "Client asked to follow up next week"
                                    },
                                    "reminder_datetime": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-01-10T10:30:00Z",
                                        "nullable": true
                                    },
                                    "meeting_range": {
                                        "type": "string",
                                        "example": "2026-01-10 10:00 - 2026-01-10 10:30",
                                        "nullable": true
                                    },
                                    "client_unit": {
                                        "type": "string",
                                        "example": "A-1203",
                                        "nullable": true
                                    },
                                    "client_price": {
                                        "type": "number",
                                        "example": 1500000,
                                        "nullable": true
                                    },
                                    "client_project": {
                                        "type": "string",
                                        "example": "Saray Towers",
                                        "nullable": true
                                    },
                                    "client_developer": {
                                        "type": "string",
                                        "example": "WR",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Moved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "lead": {
                                                    "$ref": "#/components/schemas/Lead"
                                                },
                                                "latest_path": {
                                                    "$ref": "#/components/schemas/LeadPath"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found or not visible",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/leads/{id}/paths": {
            "get": {
                "tags": [
                    "Lead Paths"
                ],
                "summary": "Get lead history (paths)",
                "description": "Returns paginated lead history. Sales/Tele-sales see only their own paths.",
                "operationId": "getLeadPaths",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Lead ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 123
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page (max 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1,
                            "example": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated lead paths",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/LeadPath"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginationMeta"
                                        },
                                        "links": {
                                            "$ref": "#/components/schemas/PaginationLinks"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Lead not found or not visible",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ApiError": {
                "description": "Standard API error response",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "code": {
                        "type": "string",
                        "example": "INVALID_CREDENTIALS"
                    },
                    "message": {
                        "type": "string",
                        "example": "Invalid credentials"
                    },
                    "data": {
                        "example": null,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PaginationLinks": {
                "description": "Pagination navigation links",
                "properties": {
                    "first": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://api.example.com/api/v1/leads?page=1",
                        "nullable": true
                    },
                    "prev": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://api.example.com/api/v1/leads?page=1",
                        "nullable": true
                    },
                    "next": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://api.example.com/api/v1/leads?page=3",
                        "nullable": true
                    },
                    "last": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://api.example.com/api/v1/leads?page=7",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "description": "Pagination metadata",
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 2
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 20
                    },
                    "total": {
                        "type": "integer",
                        "example": 134
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 7
                    },
                    "links": {
                        "$ref": "#/components/schemas/PaginationLinks"
                    }
                },
                "type": "object"
            },
            "ValidationErrorsMap": {
                "description": "Validation errors mapped by field name",
                "type": "object",
                "additionalProperties": {
                    "schema": "Controller",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "Controller": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "ValidationErrorData": {
                "properties": {
                    "errors": {
                        "$ref": "#/components/schemas/ValidationErrorsMap"
                    }
                },
                "type": "object"
            },
            "ApiValidationError": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "code": {
                        "type": "string",
                        "example": "VALIDATION_ERROR"
                    },
                    "message": {
                        "type": "string",
                        "example": "The given data was invalid."
                    },
                    "data": {
                        "$ref": "#/components/schemas/ValidationErrorData"
                    }
                },
                "type": "object"
            },
            "Lead": {
                "title": "Lead",
                "description": "Lead object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 123
                    },
                    "full_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "phone": {
                        "type": "string",
                        "example": "00971501234567"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "status": {
                        "$ref": "#/components/schemas/Status"
                    },
                    "source": {
                        "$ref": "#/components/schemas/Source"
                    },
                    "assigned_to": {
                        "$ref": "#/components/schemas/UserLite"
                    },
                    "assigner": {
                        "$ref": "#/components/schemas/UserLite"
                    },
                    "last_follow_up": {
                        "type": "string",
                        "example": "Called the client and scheduled a meeting",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-10T09:30:00Z"
                    }
                },
                "type": "object"
            },
            "UserLite": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 25
                    },
                    "name": {
                        "type": "string",
                        "example": "Tony Stark"
                    }
                },
                "type": "object"
            },
            "Status": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "name": {
                        "type": "string",
                        "example": "Follow Up"
                    },
                    "slug": {
                        "type": "string",
                        "example": "follow-up"
                    }
                },
                "type": "object"
            },
            "Source": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 3
                    },
                    "name": {
                        "type": "string",
                        "example": "Facebook Lead Ads"
                    }
                },
                "type": "object"
            },
            "LeadPermissions": {
                "properties": {
                    "can_view": {
                        "type": "boolean",
                        "example": true
                    },
                    "can_view_paths": {
                        "type": "boolean",
                        "example": true
                    },
                    "can_view_all_paths": {
                        "type": "boolean",
                        "example": false
                    },
                    "can_update_status": {
                        "type": "boolean",
                        "example": true
                    },
                    "can_add_follow_up": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "LastFollowUp": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 555
                    },
                    "comment": {
                        "type": "string",
                        "example": "Call client tomorrow"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
